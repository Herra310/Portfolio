---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.role.replace(/\.$/, '')}`,
  description = profile.bio,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <meta name="theme-color" content="#f4f4f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/x-icon" href={`${base}icon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400..700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Aplica el tema antes de pintar para evitar parpadeo
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh font-sans">
    <div class="color-fields" aria-hidden="true"><span></span><span></span><span></span></div>
    <slot />
    <script>
      // Reflejo especular: la luz del vidrio sigue al puntero
      const fine = window.matchMedia('(pointer: fine)').matches;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !still) {
        let frame = 0;
        let x = 0;
        let y = 0;
        const update = () => {
          frame = 0;
          document.querySelectorAll<HTMLElement>('.glass').forEach((el) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${x - r.left}px`);
            el.style.setProperty('--my', `${y - r.top}px`);
          });
        };
        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            if (!frame) frame = requestAnimationFrame(update);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
