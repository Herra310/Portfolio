---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';

const links = [
  { href: '#stack', label: 'Stack' },
  { href: '#ia', label: 'IA' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 pt-4" data-header>
  <nav
    class="nav-capsule glass pointer-events-auto flex items-center gap-1 rounded-full p-1.5"
    aria-label="Principal"
  >
    <a
      href="#inicio"
      class="grid size-9 shrink-0 place-items-center rounded-full bg-accent text-[13px] font-semibold tracking-tight text-accent-fg"
      aria-label={`${profile.name}, ir al inicio`}
    >
      JH
    </a>

    <ul class="hidden items-center sm:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="nav-link block rounded-full px-4 py-2 text-sm text-muted transition-colors duration-300 hover:bg-chip hover:text-fg"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#contacto"
      class="rounded-full bg-chip px-4 py-2 text-sm font-medium text-accent-text sm:hidden"
    >
      Contáctame
    </a>

    <ThemeToggle />

    <details class="group relative sm:hidden" data-mobile-menu>
      <summary
        class="grid size-9 cursor-pointer place-items-center rounded-full text-muted hover:text-fg"
        aria-label="Abrir menú"
      >
        <span class="group-open:hidden"><Icon name="menu" class="size-[18px]" /></span>
        <span class="hidden group-open:block"><Icon name="close" class="size-[18px]" /></span>
      </summary>
      <ul class="glass absolute right-0 mt-3 w-52 rounded-3xl p-2">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="block rounded-2xl px-4 py-2.5 text-[15px] hover:bg-chip">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>

<style>
  .nav-capsule {
    transform-origin: top center;
    transition:
      padding 0.6s var(--ease-out-expo),
      background-color 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }
  .nav-link {
    transition:
      padding 0.6s var(--ease-out-expo),
      color 0.3s,
      background-color 0.3s;
  }
  [data-scrolled] .nav-capsule {
    padding: 0.2rem;
    background: var(--glass-solid);
    transform: translateY(-6px) scale(0.86);
    box-shadow:
      inset 0 1px 0 var(--glass-edge),
      0 22px 44px -16px rgb(40 26 100 / 0.32),
      0 6px 14px -6px rgb(40 26 100 / 0.16);
  }
  [data-scrolled] .nav-link {
    padding: 0.4rem 0.55rem;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Cierra el menú móvil al elegir un enlace
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
</script>
