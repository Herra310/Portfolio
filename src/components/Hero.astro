---
import ContactCard from './ContactCard.astro';
import { profile } from '../data/profile';
---

<section id="inicio" class="px-4 pt-32 pb-24 sm:px-6 sm:pt-40 lg:pb-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h1 class="text-[clamp(3.1rem,8vw,6rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
        Desarrollador <span class="text-accent-text">web.</span>
      </h1>
      <p class="mt-7 max-w-[54ch] text-[17px] leading-relaxed text-pretty text-muted sm:text-xl sm:leading-relaxed">
        {profile.bio}
      </p>
    </div>

    <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <ContactCard />
    </div>
  </div>
</section>
