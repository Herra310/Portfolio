---
import ContactCard from './ContactCard.astro';
import { profile } from '../data/profile';
import { stack } from '../data/stack';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const main = stack.slice(0, 4);
---

<section id="inicio" class="flex items-center px-4 pt-32 pb-24 sm:px-6 sm:pt-36 lg:min-h-svh lg:pb-20">
  <div class="mx-auto grid w-full max-w-6xl items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <h1 class="text-[clamp(3.1rem,8vw,6rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
        Desarrollador <span class="text-accent-text">web.</span>
      </h1>
      <p class="mt-7 max-w-[60ch] text-[17px] leading-relaxed text-pretty text-muted sm:text-xl sm:leading-relaxed">
        {profile.intro}
      </p>
      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Stack principal">
        {
          main.map((t) => (
            <li class="glass flex items-center gap-2 rounded-full py-1.5 pr-4 pl-2 text-sm">
              <img src={`${base}${t.image}`} alt="" class="size-5 object-contain" />
              {t.name}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <ContactCard />
    </div>
  </div>
</section>
