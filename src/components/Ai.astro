---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { aiIntro, aiItems } from '../data/ai';
---

<section id="ia" class="px-4 py-20 sm:px-6 lg:py-28">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
    <SectionTitle class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start" title="IA en mi flujo de trabajo" intro={aiIntro} />

    <ul class="divide-y divide-line border-y border-line lg:col-span-8">
      {
        aiItems.map((item) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-5 py-8">
            <span class="chip grid size-10 place-items-center rounded-full text-accent-text">
              <Icon name={item.icon} class="size-5" />
            </span>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-2 max-w-[62ch] leading-relaxed text-muted">{item.description}</p>
              <p class="mt-4 text-sm text-muted">
                {item.tags.map((tag, i) => (
                  <>
                    {i > 0 && <span class="mx-2 text-line" aria-hidden="true">/</span>}
                    <span class="text-fg/80">{tag}</span>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
