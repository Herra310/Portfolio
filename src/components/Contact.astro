---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="contacto" class="px-4 pt-20 pb-28 sm:px-6 lg:pt-28 lg:pb-36">
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="text-[clamp(2.5rem,7vw,5rem)] leading-none font-semibold tracking-[-0.04em]">Contáctame</h2>

    <a
      href={`mailto:${profile.email}`}
      class="mt-8 inline-block text-[clamp(1.15rem,3.2vw,2rem)] font-medium tracking-tight break-all text-accent-text underline decoration-accent-text/30 decoration-2 underline-offset-[6px] transition hover:decoration-accent-text"
    >
      {profile.email}
    </a>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center gap-2 rounded-full px-5 py-3 text-[15px] transition duration-300 hover:-translate-y-px"
      >
        <Icon name="linkedin" class="size-[18px]" />
        LinkedIn
      </a>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center gap-2 rounded-full px-5 py-3 text-[15px] transition duration-300 hover:-translate-y-px"
      >
        <Icon name="github" class="size-[18px]" />
        GitHub
      </a>
      <a
        href={`${base}${profile.cv}`}
        download
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-[15px] font-medium text-accent-fg shadow-[0_10px_24px_-12px_rgb(116_71_245/0.8)] transition duration-300 hover:-translate-y-px hover:brightness-110 active:scale-[0.98]"
      >
        <Icon name="download" class="size-[18px]" />
        Descargar CV
      </a>
    </div>
  </div>
</section>
